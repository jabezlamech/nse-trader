# Zerodha Kite Connect Credentials
# Copy this file to .env and fill in your values.
# Get these from: https://developers.kite.trade/apps

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here

# Optional: paste a valid access token here to skip the login step.
# Access tokens expire at the end of each trading day.
KITE_ACCESS_TOKEN=
